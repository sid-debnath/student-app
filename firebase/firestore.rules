rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function institutionDoc(iid) {
      return /databases/$(database)/documents/institutions/$(iid);
    }
    function userPath(iid) {
      return /databases/$(database)/documents/institutions/$(iid)/users/$(request.auth.uid);
    }
    function hasProfile(iid) {
      return signedIn() && exists(userPath(iid));
    }
    function userDoc(iid) {
      return get(userPath(iid)).data;
    }
    function isAdmin(iid) {
      return hasProfile(iid) && userDoc(iid).role == 'admin';
    }
    function isTeacher(iid) {
      return hasProfile(iid) && userDoc(iid).role == 'teacher';
    }
    function isViewer(iid) {
      return hasProfile(iid) && userDoc(iid).role == 'viewer';
    }
    function viewerOwnsStudent(iid, studentId) {
      return isViewer(iid) && studentId in userDoc(iid).studentIds;
    }
    function bootstrapping(iid) {
      return signedIn() && iid == 'default' && !exists(institutionDoc('default'));
    }

    match /institutions/{iid} {
      allow create: if bootstrapping(iid);
      // First-time setup must be able to see that the institution doc is missing.
      allow get: if hasProfile(iid)
        || (signedIn() && iid == 'default' && !exists(institutionDoc(iid)));
      allow list: if hasProfile(iid);
      allow update, delete: if isAdmin(iid);

      match /users/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || isAdmin(iid));
        allow list: if isAdmin(iid);
        allow create: if isAdmin(iid)
          || (
            bootstrapping(iid)
            && uid == request.auth.uid
            && request.resource.data.role == 'admin'
            && request.resource.data.institutionId == iid
          );
        allow update: if isAdmin(iid)
          || (
            hasProfile(iid)
            && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmToken'])
          );
        allow delete: if isAdmin(iid);
      }
      match /classes/{classId} {
        allow read: if hasProfile(iid);
        allow create: if isAdmin(iid) || bootstrapping(iid);
        allow update, delete: if isAdmin(iid);
      }
      match /students/{studentId} {
        allow read: if hasProfile(iid) && (isAdmin(iid) || isTeacher(iid) || viewerOwnsStudent(iid, studentId));
        allow create: if isAdmin(iid) || bootstrapping(iid);
        allow update, delete: if isAdmin(iid);
      }
      match /attendance/{docId} {
        allow read: if hasProfile(iid);
        allow write: if hasProfile(iid) && (isAdmin(iid) || isTeacher(iid));
      }
      match /homework/{docId} {
        allow read: if hasProfile(iid);
        allow create, update, delete: if hasProfile(iid) && (isAdmin(iid) || isTeacher(iid));
        match /files/{fileId} {
          allow read: if hasProfile(iid);
          allow write: if hasProfile(iid) && (isAdmin(iid) || isTeacher(iid));
        }
      }
      match /timetable/{classId}/periods/{periodId} {
        allow read: if hasProfile(iid);
        allow write: if hasProfile(iid) && (isAdmin(iid) || isTeacher(iid));
      }
      match /exams/{docId} {
        allow read: if hasProfile(iid);
        allow write: if hasProfile(iid) && (isAdmin(iid) || isTeacher(iid));
      }
      match /marks/{docId} {
        allow read: if hasProfile(iid);
        allow write: if hasProfile(iid) && (isAdmin(iid) || isTeacher(iid));
      }
      match /reportCards/{docId} {
        allow read: if hasProfile(iid) && (isAdmin(iid) || isTeacher(iid) || viewerOwnsStudent(iid, resource.data.studentId));
        allow write: if hasProfile(iid) && (isAdmin(iid) || isTeacher(iid));
      }
      match /announcements/{docId} {
        allow read: if hasProfile(iid);
        allow write: if isAdmin(iid);
      }
      match /ptmSlots/{docId} {
        allow read: if hasProfile(iid);
        allow create, update: if hasProfile(iid) && (isAdmin(iid) || (isTeacher(iid) && request.resource.data.teacherId == request.auth.uid));
        allow delete: if hasProfile(iid) && (isAdmin(iid) || isTeacher(iid));
      }
      match /ptmBookings/{docId} {
        allow read: if hasProfile(iid);
        allow create: if hasProfile(iid) && (isAdmin(iid) || isViewer(iid));
        allow update, delete: if hasProfile(iid) && (isAdmin(iid) || isTeacher(iid));
      }
      match /ptmNotes/{docId} {
        allow read: if hasProfile(iid);
        allow write: if hasProfile(iid) && (isAdmin(iid) || isTeacher(iid));
      }
    }
  }
}
